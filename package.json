{
  "name": "nix-prompt",
  "version": "0.1.0",
  "description": "Nix風に関数型・宣言的に画像生成プロンプトを書き、モデルごとの正しい順序へ正規化して出力するコンパイラ",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "nix-prompt": "./src/cli.ts"
  },
  "scripts": {
    "compile": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "web:examples": "bun run scripts/gen-examples.ts",
    "web:check": "svelte-check --tsconfig ./tsconfig.web.json",
    "web:smoke": "vite build && vite build --ssr ssr/smoke-entry.ts --outDir dist-ssr && bun run scripts/smoke-web.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "latest",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5",
    "vite": "^8.3.4"
  }
}
